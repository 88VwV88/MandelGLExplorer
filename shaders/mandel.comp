
#version 430

layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba8, binding = 0) uniform writeonly image2D outImage;

uniform vec2  uResolution;
uniform vec2  uCenter;
uniform float uZoom;

const int MAX_ITERATIONS = 1024;
const float ESCAPE_RADIUS_SQUARED = 4.0;

vec3 palette(float t) {
    // Smooth cyclic palette: black, purple, magenta, orange, gold.
    const vec3 a = vec3(0.50, 0.35, 0.30);
    const vec3 b = vec3(0.50, 0.35, 0.40);
    const vec3 c = vec3(1.00, 1.00, 1.00);
    const vec3 d = vec3(0.00, 0.15, 0.30);

    return a + b * cos(6.2831853 * (c * t + d));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);

    if (pixel.x >= int(uResolution.x) ||
        pixel.y >= int(uResolution.y))
        return;

    vec2 uv = (vec2(pixel) / uResolution - 0.5) * 2.0;
    uv.x *= uResolution.x / uResolution.y;

    vec2 c = uCenter + uv / uZoom;
    vec2 z = vec2(0.0);

    int iteration = 0;

    for (; iteration < MAX_ITERATIONS; ++iteration) {
        float x = z.x * z.x - z.y * z.y + c.x;
        float y = 2.0 * z.x * z.y + c.y;

        z = vec2(x, y);

        if (dot(z, z) > ESCAPE_RADIUS_SQUARED)
            break;
    }

    vec3 color = vec3(0.0);

    if (iteration < MAX_ITERATIONS) {
        // Smooth escape-time coloring
        float magnitude = length(z);

        float smoothIteration =
            float(iteration) + 1.0 -
            log2(max(log2(max(magnitude, 1.000001)), 0.000001));

        // Compress iteration values into a visually useful range
        float t = smoothIteration / 180.0;

        // Nonlinear gradient mapping
        t = pow(clamp(t, 0.0, 1.0), 0.65);

        color = palette(t);
    }

    imageStore(outImage, pixel, vec4(color, 1.0));
}
